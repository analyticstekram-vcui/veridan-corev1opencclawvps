{
  "name": "OpenClawSecretReference",
  "type": "object",
  "properties": {
    "secretName": {
      "type": "string",
      "description": "Name of the secret (e.g., OPENAI_API_KEY, BROKER_API_KEY)"
    },
    "provider": {
      "type": "string",
      "enum": [
        "OpenAI",
        "OpenClaw",
        "Broker",
        "Cloudflare",
        "External",
        "Custom"
      ],
      "description": "Provider/system this secret belongs to"
    },
    "purpose": {
      "type": "string",
      "description": "Purpose of this secret (e.g., 'LLM inference', 'Broker authentication', 'HMAC signing')"
    },
    "storageLocation": {
      "type": "string",
      "enum": [
        "environment_variable",
        "managed_vault",
        "key_management_service",
        "hardcoded",
        "unknown"
      ],
      "description": "Where the actual secret is stored"
    },
    "environment": {
      "type": "string",
      "enum": [
        "development",
        "staging",
        "production",
        "test"
      ],
      "default": "production",
      "description": "Environment this secret is used in"
    },
    "status": {
      "type": "string",
      "enum": [
        "NOT_CONFIGURED",
        "CONFIGURED",
        "ROTATION_DUE",
        "DISABLED"
      ],
      "default": "NOT_CONFIGURED",
      "description": "Configuration and rotation status"
    },
    "lastRotatedAt": {
      "type": "string",
      "format": "date-time",
      "description": "ISO timestamp of last rotation"
    },
    "nextRotationDue": {
      "type": "string",
      "format": "date-time",
      "description": "ISO timestamp when next rotation is due"
    },
    "owner": {
      "type": "string",
      "description": "Email or identifier of the secret owner/maintainer"
    },
    "accessScope": {
      "type": "string",
      "enum": [
        "read_only",
        "read_write",
        "admin",
        "service_account"
      ],
      "description": "Scope of access this secret grants"
    },
    "riskTier": {
      "type": "string",
      "enum": [
        "low",
        "medium",
        "high",
        "critical"
      ],
      "description": "Risk classification for this secret"
    },
    "notes": {
      "type": "string",
      "description": "Operator notes, rotation history, or risk assessment notes"
    }
  },
  "required": [
    "secretName",
    "provider",
    "purpose",
    "storageLocation"
  ]
}