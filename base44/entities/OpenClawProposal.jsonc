{
  "name": "OpenClawProposal",
  "type": "object",
  "properties": {
    "requestId": {
      "type": "string",
      "description": "Unique request identifier for the proposal"
    },
    "proposedBy": {
      "type": "string",
      "description": "Email of the operator who created this proposal"
    },
    "commandType": {
      "type": "string",
      "enum": [
        "READ",
        "VERIFY",
        "NAVIGATE_READ_ONLY",
        "SNAPSHOT",
        "EXPORT_LOG",
        "PROPOSE_WORKFLOW"
      ],
      "description": "Type of command being proposed"
    },
    "target": {
      "type": "string",
      "description": "Target system or resource (e.g., gateway, browser, audit log)"
    },
    "selector": {
      "type": "string",
      "description": "CSS selector or element identifier if applicable"
    },
    "url": {
      "type": "string",
      "description": "URL target if applicable"
    },
    "payloadPreview": {
      "type": "object",
      "description": "Safe preview of the proposed command payload (no credentials, tokens, or sensitive data)"
    },
    "riskTier": {
      "type": "string",
      "enum": [
        "LOW",
        "MEDIUM"
      ],
      "default": "LOW",
      "description": "Risk classification for this proposal"
    },
    "policyGate": {
      "type": "string",
      "enum": [
        "PASS",
        "FAIL"
      ],
      "description": "Policy validation result"
    },
    "status": {
      "type": "string",
      "enum": [
        "DRAFT",
        "PENDING_APPROVAL",
        "APPROVED",
        "DENIED",
        "EXPIRED"
      ],
      "default": "DRAFT",
      "description": "Current lifecycle status of the proposal"
    },
    "createdAt": {
      "type": "string",
      "format": "date-time",
      "description": "ISO timestamp when proposal was created"
    },
    "reviewedAt": {
      "type": "string",
      "format": "date-time",
      "description": "ISO timestamp when proposal was reviewed"
    },
    "reviewedBy": {
      "type": "string",
      "description": "Email of the reviewer/approver"
    },
    "reviewNote": {
      "type": "string",
      "description": "Reviewer's notes on approval or denial"
    },
    "expiresAt": {
      "type": "string",
      "format": "date-time",
      "description": "Optional expiration timestamp for the proposal"
    },
    "auditTraceId": {
      "type": "string",
      "description": "Reference to audit trail entries for this proposal"
    }
  },
  "required": [
    "requestId",
    "proposedBy",
    "commandType",
    "target",
    "status",
    "createdAt"
  ]
}