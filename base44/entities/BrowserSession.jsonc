{
  "name": "BrowserSession",
  "type": "object",
  "properties": {
    "sessionId": {
      "type": "string",
      "description": "Unique session identifier"
    },
    "status": {
      "type": "string",
      "enum": [
        "inactive",
        "active",
        "ended",
        "error"
      ],
      "default": "inactive"
    },
    "mode": {
      "type": "string",
      "enum": [
        "real_browser",
        "simulated"
      ],
      "default": "real_browser"
    },
    "governance": {
      "type": "string",
      "enum": [
        "safe_read_only"
      ],
      "default": "safe_read_only"
    },
    "currentUrl": {
      "type": "string"
    },
    "pageTitle": {
      "type": "string"
    },
    "lastAction": {
      "type": "string",
      "enum": [
        "start",
        "navigate",
        "read_title",
        "read_page_text",
        "screenshot",
        "end",
        "inspect_elements",
        "read_element_text",
        "click_element",
        "type_into_element",
        "propose_action",
        "approve_proposal",
        "queue_execution",
        "execute_command"
      ],
      "description": "Last action performed in the session"
    },
    "diagnostics": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "auditTrail": {
      "type": "array",
      "description": "Ordered log of all session actions (capped at 50 entries, metadata-only)",
      "items": {
        "type": "object"
      }
    },
    "createdBy": {
      "type": "string"
    },
    "createdAt": {
      "type": "string"
    },
    "endedAt": {
      "type": "string"
    }
  },
  "required": [
    "sessionId",
    "createdBy"
  ]
}