{
  "name": "OpenClawBrokerCredentialReference",
  "type": "object",
  "properties": {
    "brokerName": {
      "type": "string",
      "description": "Name of the broker (e.g., Tradovate, TradingView, BloFin, Alpaca)"
    },
    "accountLabel": {
      "type": "string",
      "description": "Friendly label for this account (e.g., 'Paper Trading', 'Read-Only Monitor')"
    },
    "environment": {
      "type": "string",
      "enum": [
        "paper",
        "demo",
        "live"
      ],
      "description": "Trading environment this credential is for"
    },
    "credentialStatus": {
      "type": "string",
      "enum": [
        "NOT_CONNECTED",
        "METADATA_ONLY",
        "VAULT_PENDING",
        "VAULTED",
        "DISABLED"
      ],
      "default": "NOT_CONNECTED",
      "description": "Status of credential configuration"
    },
    "vaultProvider": {
      "type": "string",
      "enum": [
        "aws_secrets_manager",
        "hashicorp_vault",
        "azure_keyvault",
        "hsm",
        "pending",
        "none"
      ],
      "description": "Where credentials are/will be vaulted"
    },
    "secretReferenceId": {
      "type": "string",
      "description": "Reference ID to the secret in vault (not the secret itself)"
    },
    "allowedScopes": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Allowed API scopes (e.g., 'read_positions', 'place_orders', 'view_charts')"
    },
    "tradingModeAllowed": {
      "type": "string",
      "enum": [
        "NONE",
        "READ_ONLY",
        "PAPER_ONLY",
        "LIVE_BLOCKED"
      ],
      "default": "NONE",
      "description": "Maximum trading mode allowed with this credential"
    },
    "lastVerifiedAt": {
      "type": "string",
      "format": "date-time",
      "description": "Last time credential connectivity was verified"
    },
    "nextRotationDue": {
      "type": "string",
      "format": "date-time",
      "description": "Next credential rotation due date"
    },
    "owner": {
      "type": "string",
      "description": "Email or identifier of credential owner"
    },
    "riskTier": {
      "type": "string",
      "enum": [
        "low",
        "medium",
        "high",
        "critical"
      ],
      "description": "Risk classification"
    },
    "notes": {
      "type": "string",
      "description": "Operator notes and readiness status"
    }
  },
  "required": [
    "brokerName",
    "accountLabel",
    "environment",
    "credentialStatus"
  ]
}