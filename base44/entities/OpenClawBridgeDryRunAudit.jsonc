{
  "name": "OpenClawBridgeDryRunAudit",
  "type": "object",
  "properties": {
    "dryRunAuditId": {
      "type": "string",
      "description": "Unique dry-run audit trail identifier"
    },
    "dryRunId": {
      "type": "string",
      "description": "Dry-run execution ID"
    },
    "requestId": {
      "type": "string",
      "description": "Bridge request ID if provided"
    },
    "proposalId": {
      "type": "string",
      "description": "Proposal ID if provided"
    },
    "previewHash": {
      "type": "string",
      "description": "Bundle preview hash if provided"
    },
    "operatorId": {
      "type": "string",
      "description": "Email of operator who submitted the request"
    },
    "acceptedForDryRun": {
      "type": "boolean",
      "description": "Whether the request was accepted for dry-run preview"
    },
    "rejectedReason": {
      "type": "string",
      "description": "Reason if rejected, null if accepted"
    },
    "commandType": {
      "type": "string",
      "description": "Command type (READ, NAVIGATE, EXTRACT, VERIFY) if provided"
    },
    "riskTier": {
      "type": "string",
      "description": "Risk tier (LOW, MEDIUM) if provided"
    },
    "targetUrl": {
      "type": "string",
      "description": "Target URL from the bridge request if provided"
    },
    "policyGateResult": {
      "type": "string",
      "enum": [
        "PASS",
        "FAIL"
      ],
      "description": "Policy gate check result"
    },
    "policyGateMessages": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Policy gate failure reasons"
    },
    "replayCheckResult": {
      "type": "string",
      "enum": [
        "PASS",
        "FAIL"
      ],
      "description": "Replay protection check result"
    },
    "replayCheckMessages": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Replay check failure reasons"
    },
    "signatureCheckResult": {
      "type": "string",
      "enum": [
        "PASS",
        "FAIL"
      ],
      "description": "Signature validation check result"
    },
    "signatureCheckMessages": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Signature validation failure reasons"
    },
    "bridgeMode": {
      "type": "string",
      "enum": [
        "OPENCLAW_DRY_RUN_PREVIEW"
      ],
      "default": "OPENCLAW_DRY_RUN_PREVIEW",
      "description": "Always OPENCLAW_DRY_RUN_PREVIEW"
    },
    "executionStatus": {
      "type": "string",
      "enum": [
        "PREVIEW_ONLY",
        "REJECTED_NOT_EXECUTED"
      ],
      "description": "Execution status of the request"
    },
    "secretExposed": {
      "type": "boolean",
      "default": false,
      "description": "Whether any secret was exposed (hardcoded false)"
    },
    "inputTextPresent": {
      "type": "boolean",
      "description": "True if inputText was provided (not stored)"
    },
    "createdAt": {
      "type": "string",
      "format": "date-time",
      "description": "ISO timestamp when record was created"
    },
    "note": {
      "type": "string",
      "description": "Standard note indicating dry-run only"
    }
  },
  "required": [
    "dryRunAuditId",
    "acceptedForDryRun",
    "bridgeMode",
    "executionStatus",
    "createdAt",
    "note"
  ]
}