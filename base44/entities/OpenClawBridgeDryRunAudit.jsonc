{
  "name": "OpenClawBridgeDryRunAudit",
  "type": "object",
  "properties": {
    "auditId": {
      "type": "string",
      "description": "Unique audit trail identifier"
    },
    "requestId": {
      "type": "string",
      "description": "Bridge request ID if provided"
    },
    "previewHash": {
      "type": "string",
      "description": "Bundle preview hash if provided"
    },
    "operatorId": {
      "type": "string",
      "description": "Email of operator who submitted the request"
    },
    "accepted": {
      "type": "boolean",
      "description": "Whether the request passed validation"
    },
    "rejectedReason": {
      "type": "string",
      "description": "Reason if rejected, null if accepted"
    },
    "bridgeMode": {
      "type": "string",
      "enum": [
        "DRY_RUN_ONLY"
      ],
      "default": "DRY_RUN_ONLY",
      "description": "Always DRY_RUN_ONLY for Phases 1-4A"
    },
    "executionStatus": {
      "type": "string",
      "enum": [
        "NOT_EXECUTED",
        "REJECTED_NOT_EXECUTED"
      ],
      "description": "Execution status of the request"
    },
    "targetUrl": {
      "type": "string",
      "description": "Target URL from the bridge request if provided"
    },
    "commandType": {
      "type": "string",
      "description": "Command type (READ, NAVIGATE, EXTRACT, VERIFY) if provided"
    },
    "riskTier": {
      "type": "string",
      "description": "Risk tier (LOW, MEDIUM) if provided"
    },
    "receivedAt": {
      "type": "string",
      "format": "date-time",
      "description": "ISO timestamp when request was received"
    },
    "validatedAt": {
      "type": "string",
      "format": "date-time",
      "description": "ISO timestamp when validation completed"
    },
    "validationMessages": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Array of validation error messages if any"
    },
    "inputTextPresent": {
      "type": "boolean",
      "description": "True if inputText was provided for TYPE command (not stored)"
    },
    "policyGateResult": {
      "type": "string",
      "enum": [
        "PASS",
        "FAIL"
      ],
      "description": "Phase 2: Policy gate check result"
    },
    "policyGateMessages": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Phase 2: Policy gate failure reasons"
    },
    "replayCheckResult": {
      "type": "string",
      "enum": [
        "PASS",
        "FAIL"
      ],
      "description": "Phase 2: Replay protection check result"
    },
    "replayCheckMessages": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Phase 2: Replay check failure reasons (DUPLICATE_REQUEST_ID, DUPLICATE_PREVIEW_HASH)"
    },
    "signatureCheckResult": {
      "type": "string",
      "enum": [
        "PASS",
        "FAIL"
      ],
      "description": "Phase 3: Signature validation check result"
    },
    "signatureCheckMessages": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Phase 3: Signature validation failure reasons"
    },
    "signingVersion": {
      "type": "string",
      "description": "Phase 3: Signing version used (e.g., OPENCLAW_BRIDGE_V1)"
    },
    "signedAt": {
      "type": "string",
      "format": "date-time",
      "description": "Phase 3: ISO timestamp when the request was signed"
    },
    "signaturePresent": {
      "type": "boolean",
      "description": "Phase 3: Whether signature field was present in request"
    },
    "signatureMode": {
      "type": "string",
      "description": "Phase 3-4A: Signature validation mode (e.g., MOCK_SIGNATURE_VALIDATION_PENDING_REAL_HMAC)"
    },
    "hmacSecretConfigured": {
      "type": "boolean",
      "description": "Phase 4A: Whether OPENCLAW_BRIDGE_HMAC_SECRET is configured (never stored as secret value)"
    },
    "secretExposed": {
      "type": "boolean",
      "description": "Phase 4A: Whether any secret-derived value was exposed in logs or response (hardcoded false for safety)"
    },
    "note": {
      "type": "string",
      "description": "Standard note indicating dry-run only and phases passed"
    }
  },
  "required": [
    "auditId",
    "accepted",
    "bridgeMode",
    "executionStatus",
    "receivedAt",
    "validatedAt",
    "note"
  ]
}