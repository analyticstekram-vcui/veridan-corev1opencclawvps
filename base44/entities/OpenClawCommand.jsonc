{
  "name": "OpenClawCommand",
  "type": "object",
  "properties": {
    "commandText": {
      "type": "string",
      "description": "The command to be executed"
    },
    "target": {
      "type": "string",
      "default": "OpenClaw Gateway",
      "description": "Target system"
    },
    "requestedBy": {
      "type": "string",
      "description": "User who requested the command"
    },
    "riskLevel": {
      "type": "string",
      "enum": [
        "low",
        "medium",
        "high",
        "critical"
      ],
      "default": "medium"
    },
    "entityScope": {
      "type": "string",
      "enum": [
        "vcm",
        "gfm_admin",
        "genesis_trust"
      ],
      "description": "Entity scope this command is authorized under"
    },
    "status": {
      "type": "string",
      "enum": [
        "pending",
        "approved",
        "denied",
        "executed",
        "failed",
        "cancelled"
      ],
      "default": "pending"
    },
    "approvers": {
      "type": "array",
      "description": "List of distinct approver emails (multi-sig)",
      "items": {
        "type": "string"
      }
    },
    "auditLog": {
      "type": "array",
      "description": "Hash-chained immutable audit trail",
      "items": {
        "type": "object"
      }
    },
    "notes": {
      "type": "string"
    }
  },
  "required": [
    "commandText",
    "requestedBy",
    "riskLevel",
    "entityScope"
  ]
}